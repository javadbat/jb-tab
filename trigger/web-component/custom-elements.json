            { "name": "--jb-tab-trigger-color-selected" },
            { "name": "--jb-tab-trigger-padding" },
            { "name": "--jb-tab-trigger-height" },
            { "name": "--jb-tab-trigger-font-size" },
            { "name": "--jb-tab-trigger-inline-padding" },
            { "name": "--jb-tab-trigger-block-padding" },
            { "name": "--jb-tab-trigger-border-radius" },
            { "name": "--jb-tab-trigger-primary" },
            { "name": "--jb-tab-trigger-primary-subtle" },
            { "name": "--jb-tab-trigger-secondary" },
            { "name": "--jb-tab-trigger-secondary-subtle" },
            { "name": "--jb-tab-trigger-positive" },
            { "name": "--jb-tab-trigger-positive-subtle" },
            { "name": "--jb-tab-trigger-danger" },
            { "name": "--jb-tab-trigger-danger-subtle" },
            { "name": "--jb-tab-trigger-warning" },
            { "name": "--jb-tab-trigger-warning-subtle" },
            { "name": "--jb-tab-trigger-light" },
