  "modules": [
    {
      "kind": "javascript-module",
      "path": "lib/jb-tab-trigger.ts",
      "declarations": [
        {
          "kind": "class",
          "name": "JBTabTriggerWebComponent",
          "description": "Focusable tab trigger controlled by its nearest jb-tab context.",
          "customElement": true,
          "tagName": "jb-tab-trigger",
          "superclass": { "name": "HTMLElement" },
          "attributes": [
            { "name": "value", "type": { "text": "string" }, "description": "Value paired with one or more content panels." },
            { "name": "disabled", "type": { "text": "boolean" }, "default": "false" },
            {
              "name": "color",
              "type": {
                "text": "'primary' | 'primary-subtle' | 'secondary' | 'secondary-subtle' | 'positive' | 'positive-subtle' | 'danger' | 'danger-subtle' | 'warning' | 'warning-subtle' | 'light' | 'dark' | string"
              },
              "description": "Indicator color variant or any valid CSS color."
            }
          ],
          "members": [
            { "kind": "field", "name": "value", "type": { "text": "string" } },
            { "kind": "field", "name": "disabled", "type": { "text": "boolean" } },
            { "kind": "field", "name": "color", "type": { "text": "string | null" } },
            { "kind": "field", "name": "selected", "type": { "text": "boolean" }, "readonly": true }
          ],
          "methods": [{ "name": "select", "description": "Dispatches the same select request as pointer or keyboard activation." }],
          "events": [
            {
              "name": "select",
              "type": { "text": "CustomEvent<{ value: string; trigger: JBTabTriggerWebComponent }>" },
              "description": "Bubbling composed selection request consumed by jb-tab."
            }
          ],
          "slots": [{ "name": "", "description": "Visible trigger label or custom content." }],
          "cssParts": [{ "name": "content" }],
          "cssProperties": [
